# Copiar a .env (que queda fuera de git) antes de "docker-compose up".
# Generar claves nuevas con: openssl rand -base64 32
# Estas dos son obligatorias (AD-08): sin ellas la app no arranca.
HRSAAS_CRYPTO_DATA_KEY=
HRSAAS_CRYPTO_HMAC_KEY=

# Opcional, por defecto "hrsaas-documents" (ver docker-compose.yml).
HRSAAS_STORAGE_S3_BUCKET=hrsaas-documents
